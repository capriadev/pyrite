# Pyrite backend - infrastructure .env
# Copy to .env (gitignored) and adjust. Production port block: 300xx.
# TEST block (301xx) is for isolated test/other-version instances if/when needed.
# Database is created by the pyrite postgres container (pyrite + pyrite_test).

# Backend (HTTP + WS gateway)
BACKEND_PORT=30001

# PostgreSQL (host port; inside the docker network it is 5432)
DB_HOST=127.0.0.1
DB_PORT=30010
DB_USER=pyrite
DB_PASSWORD=pyrite
DB_NAME=pyrite

# Redis (host port; inside the docker network it is 6379)
REDIS_HOST=127.0.0.1
REDIS_PORT=30011

# ============================================================
# Crypto - Argon2id profiles (strength by domain)
# Each profile is reused across sections; one module, one schema.
# Generate peppers with: $bytes = New-Object byte[] 32; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes); [Convert]::ToBase64String($bytes)
# ============================================================

# --- Login (hash-mode, verification only) ---
PASSWORD_PEPPER=replace-with-openssl-rand-base64-32

# --- Crypto strength profiles ---
CRYPTO_PROFILE_LIGHT_MEMORY=19456
CRYPTO_PROFILE_LIGHT_TIME=2
CRYPTO_PROFILE_LIGHT_PARALLELISM=1
CRYPTO_PROFILE_LIGHT_SHARED_SALT=true

CRYPTO_PROFILE_MEDIUM_MEMORY=65536
CRYPTO_PROFILE_MEDIUM_TIME=3
CRYPTO_PROFILE_MEDIUM_PARALLELISM=2
CRYPTO_PROFILE_MEDIUM_SHARED_SALT=true

CRYPTO_PROFILE_HEAVY_MEMORY=131072
CRYPTO_PROFILE_HEAVY_TIME=4
CRYPTO_PROFILE_HEAVY_PARALLELISM=2
CRYPTO_PROFILE_HEAVY_SHARED_SALT=false

# --- Pepper per section ---
CRYPTO_NOTES_PEPPER=replace-with-openssl-rand-base64-32
CRYPTO_NOTES_PRIVATE_PEPPER=replace-with-openssl-rand-base64-32
CRYPTO_APIS_PEPPER=replace-with-openssl-rand-base64-32
CRYPTO_VAULT_PEPPER=replace-with-openssl-rand-base64-32
CRYPTO_COUNTS_PEPPER=replace-with-openssl-rand-base64-32

# Rates sync - desde esta fecha (inclusive)
RATES_SYNC_FROM=2025-01-01