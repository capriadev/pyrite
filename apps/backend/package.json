{
  "name": "@pyrite/backend",
  "version": "0.0.0",
  "private": true,
  "description": "Pyrite backend (Nest.js)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start:dev": "concurrently -n tsc,node -c yellow,green \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch dist/apps/backend/src/main.js\"",
    "start:prod": "node dist/apps/backend/src/main.js",
    "tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "@types/express": "^5.0.0",
    "@types/express-serve-static-core": "^5.0.0",
    "@types/qs": "^6.9.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.20.0 <25"
  }
}